# Copy to .env.local for local development. Never commit real secrets.
# Payment processing is not implemented or enabled in this starter.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configure only after creating the Supabase project:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure only after Paystack merchant approval and server-side integration:
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
